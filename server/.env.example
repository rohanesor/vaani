# VAANI server configuration. Copy to .env and fill in. Never commit .env.
# Secrets are read only by the server; the client never sees them.
# See docs/PRODUCTION_DEPLOYMENT.md for detailed configuration guide.

# Server configuration
PORT=8787
VAANI_DB_PATH=./data/vaani.db
VAANI_CORS_ORIGIN=http://localhost:5173

# REQUIRED IN PRODUCTION: JWT secret for session tokens
# Generate with: openssl rand -hex 32
VAANI_JWT_SECRET=

# Claude (Anthropic) — replies, rewrites, translation, summaries, voice-to-action
ANTHROPIC_API_KEY=
VAANI_CLAUDE_MODEL=claude-sonnet-5-5
VAANI_CLAUDE_FAST_MODEL=claude-haiku-5-5

# Gnani (Vachana) — speech-to-text (Prisma) and text-to-speech (Timbre). Cloud services.
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Kaveri

# Cost / abuse controls
VAANI_AI_RPM=20
VAANI_AI_DAILY_TOKENS=200000
VAANI_AI_TIMEOUT_MS=45000
