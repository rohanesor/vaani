<resources>
    <!-- Light theme. The WebView reads prefers-color-scheme from this theme and tokens.css does the rest. -->
    <style name="Theme.Vaani" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/vaani_window_bg</item>
        <item name="android:navigationBarColor">@color/vaani_window_bg</item>
        <item name="android:windowBackground">@color/vaani_window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Vaani.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vaani_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vaani_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Vaani</item>
    </style>
</resources>
